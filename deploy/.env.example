# Copy to deploy/.env and fill in. Keep this file only on the server; never commit it, never paste it into a chat.
# Make each secret with:  openssl rand -base64 36

# The API address (a domain that points to this server) and the panel address (where the panel is hosted).
API_DOMAIN=api.example.com
PANEL_ORIGIN=https://panel.example.com

# PostgreSQL: the superuser (used by the setup and backup scripts) and the API's restricted login (lifedrop_app).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Signs the sign-in tokens: at least 32 characters. Changing it signs everybody out.
JWT_SIGNING_KEY=
JWT_ISSUER=lifedrop
JWT_AUDIENCE=lifedrop-clients

# Requests per minute per address (the office Wi-Fi shares one address, so keep it generous) and days of exact GPS points kept (7-365; summaries stay).
RATE_LIMIT_PER_MINUTE=600
TRACKING_RETENTION_DAYS=30

# Optional: a token for /metrics (reachable from this server only). Empty turns /metrics off.
METRICS_TOKEN=

# Optional: Telegram messages for staff (docs/CHANNELS.md). Create a bot with @BotFather, then: CHANNELS_ENABLED=true, the token, the bot's user name without @,
# and the language of the messages (ckb, ar, fa or en). Push to phones needs no setting here: put the Firebase key in deploy/secrets/service-account.json (docs/PUSH.md).
CHANNELS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
CHANNELS_LANGUAGE=ckb

# Backups: the folder on this server, how many days to keep, and an optional second place (rclone remote such as b2:lifedrop-backups, or user@host:/path for scp).
BACKUP_DIR=/var/backups/lifedrop
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
