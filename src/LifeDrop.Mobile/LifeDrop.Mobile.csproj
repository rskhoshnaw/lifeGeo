<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
		<!-- CI iOS build (-p:LifeDropIosOnly=true): only iOS, so the Android workload is not needed. A dedicated property, because a global TargetFrameworks would also reach
		     the class libraries this app references (they use a single TargetFramework) and break their restore (NETSDK1005). -->
		<TargetFrameworks Condition="'$(LifeDropIosOnly)' == 'true'">net10.0-ios</TargetFrameworks>

		<!-- MAUI package version. The default is what the Android build and local work use. The iOS CI job passes -p:LifeDropMauiVersion=10.0.20 because the only workload set that
		     builds with the runners' Xcode 26.6 (10.0.401, iOS 26.5) carries MAUI 10.0.20, and the build tools and XAML generator come from the workload, not from NuGet. -->
		<LifeDropMauiVersion Condition="'$(LifeDropMauiVersion)' == ''">10.0.110</LifeDropMauiVersion>

		<OutputType>Exe</OutputType>
		<RootNamespace>LifeDrop.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>GeoTrack by Pixelo</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.pixelo.geotrack</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LifeDrop.Mobile.Auth\LifeDrop.Mobile.Auth.csproj" />
		<ProjectReference Include="..\LifeDrop.Mobile.Visits\LifeDrop.Mobile.Visits.csproj" />
		<ProjectReference Include="..\LifeDrop.Mobile.Auth.Android\LifeDrop.Mobile.Auth.Android.csproj" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
	</ItemGroup>

	<!-- iOS shares the session logic of the Android store by compiling that one file (referencing its project would also restore its net10.0-android target, which needs the Android workload). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Compile Include="..\LifeDrop.Mobile.Auth.Android\AndroidSecureCredentialStore.cs" Link="Platforms\iOS\AndroidSecureCredentialStore.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(LifeDropMauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- QR code scanning in the sign-in screen (plan step 4.7). NuGet resolves 0.5.0 (0.4.0.196 is not on the feed). -->
		<PackageReference Include="ZXing.Net.MAUI.Controls" Version="0.5.0" />
	</ItemGroup>

	<!-- Android-only packages (see the note): on iOS they cannot be restored (NU1202), so they belong to the android target only (plan step 3.8). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- ZXing 0.5.0 brings Xamarin.AndroidX.Tracing.Tracing.Ktx 1.2.0.9, whose Java classes
		     conflict with Xamarin.AndroidX.Tracing.Tracing 2.0.0 (required by Fragment.Ktx 1.9.0)
		     → "Type TraceKt$traceAsync$1 is defined multiple times" in R8.
		     Override the Ktx to match the 2.0.0 core (same pattern as the Firebase section above). -->
		<PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
		<PackageReference Include="Xamarin.AndroidX.Concurrent.Futures.Ktx" Version="1.3.0.4" />
	</ItemGroup>

	<!-- Push messages (plan step 2.14, docs/PUSH.md): Firebase is added only when google-services.json (from the owner's Firebase project) is in this folder, so a
	     build without the file works as before. The file is never committed; CI creates a dummy one to prove the Firebase code compiles. -->
	<PropertyGroup Condition="Exists('google-services.json') And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<DefineConstants>$(DefineConstants);FIREBASE</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="Exists('google-services.json') And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
		<!-- Firebase pulls newer AndroidX cores than MAUI's own "-ktx" packages: with the old ones the build fails ("Type androidx.fragment.app.FragmentKt is defined
		     multiple times"). These versions line the "-ktx" packages up with the cores NuGet resolves; update them together when MAUI or Firebase is updated. -->
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<GoogleServicesJson Include="google-services.json" />
	</ItemGroup>


	<!-- iOS push (plan step 3.8, docs/IOS.md): Firebase Messaging for iOS and the push entitlement are added only when GoogleService-Info.plist is in this folder (git-ignored; the iOS CI
	     workflow writes it from the IOS_GOOGLE_SERVICE_INFO_BASE64 secret). Without it the app builds and works as before, without push. -->
	<PropertyGroup Condition="Exists('GoogleService-Info.plist') And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<DefineConstants>$(DefineConstants);FIREBASE</DefineConstants>
		<CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>
	<ItemGroup Condition="Exists('GoogleService-Info.plist') And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="AdamE.Firebase.iOS.CloudMessaging" Version="12.10.0" />
		<BundleResource Include="GoogleService-Info.plist" />
	</ItemGroup>


	<!-- Company servers (plan step 4.2): -p:LifeDropBaseDomain=lifedrop.example (code acme -> https://acme.lifedrop.example); -p:LifeDropBootstrapUrl is the single-server fallback -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BootstrapUrl</_Parameter1>
			<_Parameter2>$(LifeDropBootstrapUrl)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BaseDomain</_Parameter1>
			<_Parameter2>$(LifeDropBaseDomain)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
