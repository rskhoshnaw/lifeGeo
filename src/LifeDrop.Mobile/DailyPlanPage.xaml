<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LifeDrop.Mobile"
             x:Class="LifeDrop.Mobile.DailyPlanPage">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Label x:Name="DateLabel" Grid.Row="0" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            <Label x:Name="MessageLabel" IsVisible="False" />
            <Button x:Name="RetryBtn" Clicked="OnRetryClicked" IsVisible="False" HorizontalOptions="Start" />
            <Button x:Name="AddBtn" Clicked="OnAddClicked" HorizontalOptions="Start" />
        </VerticalStackLayout>

        <RefreshView x:Name="Refresher" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView x:Name="VisitList" SelectionMode="Single" SelectionChanged="OnVisitSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:VisitRow">
                        <Border Padding="12" Margin="0,0,0,8" StrokeThickness="1">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Customer}" FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Time}" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Details}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Status}" FontAttributes="Bold" />
                                <!-- Plan changes (step 1.23): order and another day -->
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8" Margin="0,8,0,0">
                                    <Button Text="▲" Clicked="OnMoveUp" IsVisible="{Binding CanMoveUp}" SemanticProperties.Description="{Binding MoveUpText}" />
                                    <Button Text="▼" Clicked="OnMoveDown" IsVisible="{Binding CanMoveDown}" SemanticProperties.Description="{Binding MoveDownText}" />
                                    <Button Text="{Binding PostponeText}" Clicked="OnPostpone" IsVisible="{Binding CanPostpone}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
