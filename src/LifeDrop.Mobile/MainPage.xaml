<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeDrop.Mobile.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="15" VerticalOptions="Center">

            <Label Text="LifeDrop Auth" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <!-- Development-only setting -->
            <Entry x:Name="ApiUrlEntry" Placeholder="API Address" Text="http://127.0.0.1:5256" IsVisible="True" />
            
            <Entry x:Name="TenantEntry" Placeholder="Tenant Code" />
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
            <Entry x:Name="DeviceLabelEntry" Placeholder="Device Label" Text="My Test Device" />

            <Button x:Name="RegisterBtn" Text="Register Device" Clicked="OnRegisterClicked" />
            <Button x:Name="LoginBtn" Text="Login" Clicked="OnLoginClicked" />

            <Label x:Name="StatusLabel" Text="Checking status..." TextColor="Gray" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
