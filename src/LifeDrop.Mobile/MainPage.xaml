<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeDrop.Mobile.MainPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="LanguageItem" Clicked="OnLanguageClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="15" VerticalOptions="Center">

            <Label Text="LifeDrop" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <!-- Development-only setting -->
            <Entry x:Name="ApiUrlEntry" Text="http://127.0.0.1:5256" IsVisible="True" FlowDirection="LeftToRight" />
            
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="TenantEntry" FlowDirection="LeftToRight" Grid.Column="0" />
                <Button x:Name="QrScanBtn" Grid.Column="1" Margin="6,0,0,0"
                        WidthRequest="44" HeightRequest="44" Padding="0"
                        Clicked="OnQrScanClicked" />
            </Grid>
            <Entry x:Name="EmailEntry" Keyboard="Email" FlowDirection="LeftToRight" />
            <Entry x:Name="PasswordEntry" IsPassword="True" FlowDirection="LeftToRight" />
            <Entry x:Name="DeviceLabelEntry" />

            <Button x:Name="RegisterBtn" Clicked="OnRegisterClicked" />
            <Button x:Name="LoginBtn" Clicked="OnLoginClicked" />

            <Label x:Name="StatusLabel" TextColor="Gray" Margin="0,20,0,0" />

            <Label x:Name="SupportLabel" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
            <Label Text="© 2026 Pixelo Design" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
