<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeDrop.Mobile.HomePage">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="LanguageItem" Clicked="OnLanguageClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header: greeting + status on crimson background -->
            <Grid RowDefinitions="Auto,Auto" BackgroundColor="{StaticResource Primary}"
                  Padding="20,20,20,44">
                <Label x:Name="WelcomeLabel" Grid.Row="0"
                       Style="{StaticResource Headline}"
                       TextColor="White" HorizontalOptions="Start"
                       HorizontalTextAlignment="Start" FontSize="24" />
                <Label x:Name="StatusLabel" Grid.Row="1"
                       TextColor="#FFD5DA" FontSize="13"
                       HorizontalOptions="Start" Margin="0,4,0,0" />
            </Grid>

            <!-- Shift / CTA Hero Card (overlapping header) -->
            <Border Margin="16,-28,16,0" Padding="16,14" StrokeThickness="0"
                    BackgroundColor="{StaticResource Secondary}"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="#2A52BE" Radius="18" Offset="0,4" Opacity="0.28" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="ShiftStatusLabel" FontAttributes="Bold" FontSize="16" TextColor="White" />
                    <Label x:Name="ShiftDetailLabel" IsVisible="False" FontSize="13" TextColor="#B5C4FF" />
                    <Button x:Name="ShiftBtn" Clicked="OnShiftClicked"
                            BackgroundColor="White" TextColor="{StaticResource Secondary}"
                            CornerRadius="8" Margin="0,6,0,0" HeightRequest="44"
                            FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Module Cards Grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="12" Padding="16,20,16,8">

                <Border Grid.Row="0" Grid.Column="0" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="PlanBtn" Clicked="OnPlanClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="NewCustomerBtn" Clicked="OnNewCustomerClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="1" Grid.Column="0" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="PaymentsBtn" Clicked="OnPaymentsClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="FollowUpsBtn" Clicked="OnFollowUpsClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="2" Grid.Column="0" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="WarehouseBtn" Clicked="OnWarehouseClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="2" Grid.Column="1" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="DeliveriesBtn" Clicked="OnDeliveriesClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="3" Grid.Column="0" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="PendingBtn" Clicked="OnPendingClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="3" Grid.Column="1" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="CustomersBtn" Clicked="OnCustomersClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

                <Border Grid.Row="4" Grid.Column="0" StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 14">
                    <Button x:Name="TelegramBtn" Clicked="OnTelegramClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource MidnightBlue}"
                            HeightRequest="80" FontSize="13" FontAttributes="Bold"
                            LineBreakMode="WordWrap" />
                </Border>

            </Grid>

            <!-- Footer: logout + credits -->
            <VerticalStackLayout Padding="16,12,16,40" Spacing="10">
                <Button x:Name="LogoutBtn" Clicked="OnLogoutClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Gray500}"
                        BorderWidth="1" BorderColor="{StaticResource Gray200}"
                        CornerRadius="8" HeightRequest="44" />
                <Label x:Name="SupportLabel" FontSize="13" TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
                <Label Text="© 2026 Pixelo Design" FontSize="12" TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
