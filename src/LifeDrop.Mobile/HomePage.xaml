<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeDrop.Mobile.HomePage">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="LanguageItem" Clicked="OnLanguageClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25" VerticalOptions="Center">

            <Label x:Name="WelcomeLabel" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <Label x:Name="StatusLabel" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label x:Name="ShiftStatusLabel" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label x:Name="ShiftDetailLabel" IsVisible="False" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button x:Name="ShiftBtn" Clicked="OnShiftClicked" HorizontalOptions="Center" WidthRequest="200" />
            </VerticalStackLayout>

            <Button x:Name="PlanBtn" Clicked="OnPlanClicked" HorizontalOptions="Center" WidthRequest="200" />

            <Button x:Name="NewCustomerBtn" Clicked="OnNewCustomerClicked" HorizontalOptions="Center" WidthRequest="200" />

            <!-- Warehouse workers: the orders of their warehouse (plan step 2.3) -->
            <Button x:Name="WarehouseBtn" Clicked="OnWarehouseClicked" HorizontalOptions="Center" WidthRequest="200" />

            <!-- Drivers: the deliveries assigned to them (plan step 2.4) -->
            <Button x:Name="DeliveriesBtn" Clicked="OnDeliveriesClicked" HorizontalOptions="Center" WidthRequest="200" />

            <Button x:Name="LogoutBtn" Clicked="OnLogoutClicked" HorizontalOptions="Center" WidthRequest="200" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
