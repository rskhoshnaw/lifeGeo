<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeDrop.Mobile.HomePage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25" VerticalOptions="Center">

            <Label Text="Welcome to LifeDrop" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <Label x:Name="StatusLabel" Text="Session is active." HorizontalOptions="Center" />

            <Button x:Name="LogoutBtn" Text="Logout" Clicked="OnLogoutClicked" HorizontalOptions="Center" WidthRequest="200" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
