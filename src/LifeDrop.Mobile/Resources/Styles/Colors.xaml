<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Pixelo GeoTracking palette — سه تم:
         روشن  (Light, default): کرمزی #E52B50 / آبی #2A52BE
         تاریک (Dark):  رنگ‌های روشن‌تر روی پس‌زمینه تاریک — خودکار از AppThemeBinding
         اقیانوسی (Ocean): رنگ‌های Cyan-Teal — برای تغییر تم، مقادیر ThemeOcean را روی Primary/Secondary کپی کنید.
         "Magenta" و "MidnightBlue" کلیدهای legacy‌اند؛ برای سازگاری نگه داشته شدند.
         برای رنگ Android status bar: Platforms\Android\Resources\values\colors.xml -->

    <!-- ── روشن / Light (active) ── -->
    <Color x:Key="Primary">#E52B50</Color>
    <Color x:Key="PrimaryDark">#FF6B87</Color>
    <Color x:Key="PrimaryDarkText">#FFD5DA</Color>
    <Color x:Key="Secondary">#2A52BE</Color>
    <Color x:Key="SecondaryDarkText">#B5C4FF</Color>
    <Color x:Key="Tertiary">#0F172A</Color>

    <!-- ── اقیانوسی / Ocean (swap با Primary/Secondary برای فعال‌سازی) ── -->
    <Color x:Key="ThemeOceanPrimary">#0891B2</Color>
    <Color x:Key="ThemeOceanPrimaryDark">#67E8F9</Color>
    <Color x:Key="ThemeOceanSecondary">#0F766E</Color>
    <Color x:Key="ThemeOceanSecondaryDark">#5EEAD4</Color>
    <Color x:Key="ThemeOceanPaper">#F0FDFA</Color>

    <Color x:Key="Paper">#F8FAFC</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#E52B50</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <Color x:Key="Emerald">#10B981</Color>
    <Color x:Key="Amber">#F59E0B</Color>

    <!-- ── خاکستری / Neutrals (cool Slate) ── -->
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>