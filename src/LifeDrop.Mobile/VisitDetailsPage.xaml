<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LifeDrop.Mobile.VisitDetailsPage">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label x:Name="CustomerLabel" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />
            <Label x:Name="DetailsLabel" />
            <Label x:Name="TimeLabel" />
            <Label x:Name="StatusLabel" FontAttributes="Bold" />
            <Label x:Name="ReasonLabel" IsVisible="False" />

            <!-- Start trip / I have arrived / Check in here -->
            <Button x:Name="StepBtn" Clicked="OnStepClicked" IsVisible="False" />

            <!-- Report and check-out (InVisit) -->
            <VerticalStackLayout x:Name="ReportForm" Spacing="8" IsVisible="False">
                <Label x:Name="ReportTitleLabel" FontAttributes="Bold" />
                <Picker x:Name="OutcomePicker" />
                <Editor x:Name="NoteEditor" AutoSize="TextChanges" MaxLength="2000" HeightRequest="120" />
                <Label x:Name="ReportSavedLabel" IsVisible="False" />
                <Button x:Name="SubmitBtn" Clicked="OnSubmitClicked" />
                <Button x:Name="RetryCheckOutBtn" Clicked="OnRetryCheckOutClicked" IsVisible="False" />
            </VerticalStackLayout>

            <!-- Steps saved on the phone and their state (plan step 1.14) -->
            <Label x:Name="StepsLabel" IsVisible="False" />

            <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" />
            <Label x:Name="MessageLabel" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
